{
  "type": "object",
  "properties": {
    "state": {
      "type": "string",
      "enum": [
        "fix verified locally",
        "left as-is",
        "handed back",
        "blocked"
      ]
    },
    "summary": {
      "type": "string",
      "description": "One line, shown on the status page."
    },
    "cause": {
      "type": "string"
    },
    "verification": {
      "type": "string"
    },
    "commits": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Commit shas in your worktree, oldest first."
    },
    "bugDraft": {
      "type": "object",
      "properties": {
        "product": {
          "type": "string"
        },
        "component": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "blocks": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      },
      "required": [
        "product",
        "component",
        "summary",
        "description"
      ],
      "additionalProperties": false
    },
    "landsAfter": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "what": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "what",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "feedback": {
      "type": "array",
      "description": "Problems with the tools or inputs you used, one entry per problem.",
      "items": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string",
            "enum": [
              "fx-tests",
              "profiler-cli",
              "searchfox-cli",
              "factory",
              "inputs"
            ]
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "target",
          "text"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "state",
    "summary",
    "cause",
    "verification",
    "commits",
    "landsAfter",
    "feedback"
  ],
  "additionalProperties": false
}
