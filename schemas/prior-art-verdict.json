{
  "type": "object",
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "active",
        "reuse",
        "none"
      ],
      "description": "active: someone is working on it; reuse: an open bug to reuse; none."
    },
    "bug": {
      "type": "integer",
      "description": "The bug the verdict is about: the one someone is on, or the one to reuse."
    },
    "quote": {
      "type": "string",
      "description": "The fact the verdict rests on."
    },
    "feedback": {
      "type": "array",
      "description": "Problems with the tools or inputs you used, one entry per problem.",
      "items": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string",
            "enum": [
              "fx-tests",
              "profiler-cli",
              "searchfox-cli",
              "factory",
              "inputs"
            ]
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "target",
          "text"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "verdict",
    "quote",
    "feedback"
  ],
  "additionalProperties": false
}
