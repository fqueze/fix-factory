{
  "type": "object",
  "properties": {
    "draft": {
      "type": "object",
      "properties": {
        "product": {
          "type": "string"
        },
        "component": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "description": "Markdown: code identifiers (functions, classes, prefs, files, flags) in backticks. For a test failure, link the test's dashboard: https://tests.firefox.dev/test.html?test=<path>."
        },
        "blocks": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "bugType": {
          "type": "string",
          "enum": [
            "defect",
            "task",
            "enhancement"
          ],
          "description": "defect: shipping code misbehaves (crash, race, regression); task: tests, tooling, config, refactoring with no user-facing change; enhancement: new or changed behavior."
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "product",
        "component",
        "summary",
        "description",
        "bugType"
      ],
      "additionalProperties": false
    },
    "feedback": {
      "type": "array",
      "description": "Problems with the tools or inputs you used, one entry per problem.",
      "items": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string",
            "enum": [
              "fx-tests",
              "profiler-cli",
              "searchfox-cli",
              "factory",
              "inputs"
            ]
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "target",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "answer": {
      "type": "string",
      "description": "One or two sentences to the user: what you changed, or what you need from them when the comments are unclear (then apply only the bug-filing conventions)."
    }
  },
  "required": [
    "draft",
    "feedback",
    "answer"
  ],
  "additionalProperties": false
}
