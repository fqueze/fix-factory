{
  "type": "object",
  "properties": {
    "state": {
      "type": "string",
      "enum": [
        "adapted",
        "not trivial"
      ]
    },
    "commits": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The new shas of both commits, in stack order."
    },
    "summary": {
      "type": "string",
      "description": "One line."
    },
    "feedback": {
      "type": "array",
      "description": "Problems with the tools or inputs you used, one entry per problem.",
      "items": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string",
            "enum": [
              "fx-tests",
              "profiler-cli",
              "searchfox-cli",
              "factory",
              "inputs"
            ]
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "target",
          "text"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "state",
    "commits",
    "summary",
    "feedback"
  ],
  "additionalProperties": false
}
