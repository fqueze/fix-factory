{
  "type": "object",
  "properties": {
    "config": {
      "type": "object",
      "properties": {
        "folders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Test folders the request covers; empty when it doesn't say."
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Individual test paths the request names."
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Platforms or configs the request limits itself to."
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Other constraints stated in the text, one sentence each."
        }
      },
      "required": [
        "folders",
        "tests",
        "platforms",
        "constraints"
      ],
      "additionalProperties": false
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Anything ambiguous in the request."
    },
    "feedback": {
      "type": "array",
      "description": "Problems with the tools or inputs you used, one entry per problem.",
      "items": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string",
            "enum": [
              "fx-tests",
              "profiler-cli",
              "searchfox-cli",
              "factory",
              "inputs"
            ]
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "target",
          "text"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "config",
    "questions",
    "feedback"
  ],
  "additionalProperties": false
}
