{
  "type": "object",
  "properties": {
    "state": {
      "type": "string",
      "enum": [
        "addressed",
        "blocked"
      ]
    },
    "summary": {
      "type": "string",
      "description": "One line."
    },
    "commits": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The amended commit(s), oldest first."
    },
    "replies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "commentId": {
            "type": "integer"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "commentId",
          "text"
        ],
        "additionalProperties": false
      },
      "description": "Only where the code doesn't speak for itself."
    },
    "feedback": {
      "type": "array",
      "description": "Problems with the tools or inputs you used, one entry per problem.",
      "items": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string",
            "enum": [
              "fx-tests",
              "profiler-cli",
              "searchfox-cli",
              "factory",
              "inputs"
            ]
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "target",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "tryRequest": {
      "type": "string",
      "description": "A try push you need (a platform you don't have, or a reviewer asks for one): what it should run and why. The factory plans it, the user approves it, and you're resumed with the results."
    },
    "followUpBugs": {
      "type": "array",
      "description": "Only a bug a reviewer's comment asks you to file (a follow-up for later), never to put off what they asked you to change: a draft the user files, its number then sent to you. Not a file.",
      "items": {
        "type": "object",
        "properties": {
          "commentId": {
            "type": "integer",
            "description": "The reviewer's comment asking for this bug."
          },
          "product": {
            "type": "string"
          },
          "component": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "description": "Markdown: code identifiers in backticks."
          }
        },
        "required": [
          "commentId",
          "product",
          "component",
          "summary",
          "description"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "state",
    "summary",
    "commits",
    "replies",
    "feedback"
  ],
  "additionalProperties": false
}
